# ExamList Windows 11 easy server configuration
# Copy this file to the project root as .env, then edit DB_* and account settings.

NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=examlist_app
DB_PASSWORD=change-this-db-password
DB_NAME=examlist
DB_CONNECTION_LIMIT=10

EXAMLIST_AUTH_ENABLED=true
EXAMLIST_SESSION_SECRET=change-this-long-random-session-secret
EXAMLIST_SESSION_TTL_HOURS=8
EXAMLIST_SESSION_COOKIE_SECURE=false

# Initial login account is not generated by the setup script.
# See deploy/windows/README.md for the first super admin account setup.
# Example value:
# EXAMLIST_USERS_JSON=[{"username":"admin","displayName":"Administrator","passwordSha256":"<sha256-password>","role":"super_admin"}]
EXAMLIST_USERS_JSON=[]

# On Windows, leave this blank when Edge or Chrome is installed in the default path.
PDF_BROWSER_PATH=
PDF_STORAGE_DIR=storage/pdf-generations

# Recommended Windows mode. Docker Redis is started by deploy/windows/setup-windows.bat.
PDF_QUEUE_DRIVER=bullmq
PDF_QUEUE_NAME=examlist-pdf-generation
PDF_QUEUE_CONCURRENCY=1
PDF_QUEUE_MAX_ATTEMPTS=2
PDF_QUEUE_RETRY_DELAY_MS=5000
PDF_QUEUE_PROCESS_IN_WEB=true
PDF_GENERATION_CHUNK_SIZE=500
PDF_RETENTION_DAYS=30

REDIS_URL=redis://127.0.0.1:6379
